POSTGRES_DB=qnsentry
POSTGRES_USER=qnsentry
POSTGRES_PASSWORD=change-me

# Secret for domain ownership verification (#48): the TXT record a client adds is derived
# from it. Required, at least 32 characters, e.g. from: openssl rand -hex 32
# Keep it unchanged: a new secret invalidates every TXT record that was added before.
DOMAIN_VERIFICATION_SECRET=change-me-to-at-least-32-random-characters

# Optional: minutes before a queued or running scan counts as stuck (default 120)
# SCAN_TIMEOUT_MINUTES=120

# Optional: days after which scan results are deleted (GDPR, default 90).
# At least 1; the API and worker refuse to start otherwise
# RETENTION_DAYS=90

# Optional: breach source, "local" (test dataset, default) or "hibp" (#13)
# BREACH_SOURCE=local
# Optional: JSON dataset for the local breach source (default: the bundled test data)
# BREACH_DATASET=
# Needed for BREACH_SOURCE=hibp: your Have I Been Pwned API key (never commit it)
# HIBP_API_KEY=
# Optional: seconds between HIBP requests (default 6, fits 10 requests per minute).
# The pause is per scan and the worker runs 2 scans at once: use 12 to be safe with 10 per minute
# HIBP_MIN_INTERVAL_SECONDS=6

# Optional: Cert Spotter API key for the lookalike certificate check. Without a key Cert Spotter
# is for personal or evaluation use only; a real deployment needs one (never commit it)
# CERTSPOTTER_API_KEY=

# Optional: DNS servers for the phishing lookups, comma-separated (default 1.1.1.1,8.8.8.8,9.9.9.9).
# Empty = the DNS of the container, which on some networks makes the phishing module take minutes
# DNS_SERVERS=1.1.1.1,8.8.8.8,9.9.9.9
