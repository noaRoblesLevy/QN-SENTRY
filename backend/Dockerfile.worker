FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# OSINT tools used by the modules
# - exiftool: document metadata (#7); Archive::Zip lets it read Office files, which are ZIP archives
# - katana: website crawler (#7)
# - subfinder: subdomains from passive sources (#4); dnsx: resolves them (#4)
# The ProjectDiscovery tools are pinned and verified against their release checksums.
ARG KATANA_VERSION=1.7.0
ARG SUBFINDER_VERSION=2.17.0
ARG DNSX_VERSION=1.3.1
# Set by Docker BuildKit to the platform being built for (amd64, arm64); amd64 without BuildKit
ARG TARGETARCH
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libimage-exiftool-perl libarchive-zip-perl ca-certificates curl unzip \
    && cd /tmp \
    && install_tool() { \
        name="$1"; version="$2"; checksums="$3"; zip="${name}_${version}_linux_${TARGETARCH:-amd64}.zip"; \
        base="https://github.com/projectdiscovery/${name}/releases/download/v${version}"; \
        curl -fsSLO "${base}/${zip}" && curl -fsSLO "${base}/${checksums}" \
        && grep " ${zip}$" "${checksums}" | sha256sum -c - \
        && unzip -o "${zip}" "${name}" -d /usr/local/bin \
        && rm -f "${zip}" "${checksums}"; \
    } \
    && install_tool katana "${KATANA_VERSION}" "katana-${KATANA_VERSION}-checksums.txt" \
    && install_tool subfinder "${SUBFINDER_VERSION}" "subfinder_${SUBFINDER_VERSION}_checksums.txt" \
    && install_tool dnsx "${DNSX_VERSION}" "dnsx_${DNSX_VERSION}_checksums.txt" \
    && apt-get purge -y curl unzip \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY qnsentry ./qnsentry

RUN useradd --create-home appuser
USER appuser

CMD ["celery", "-A", "qnsentry.worker.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
