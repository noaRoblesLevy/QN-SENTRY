POSTGRES_DB=qnsentry
POSTGRES_USER=qnsentry
POSTGRES_PASSWORD=change-me

# Optional: minutes before a queued or running scan counts as stuck (default 120)
# SCAN_TIMEOUT_MINUTES=120

# Optional: days after which scan results are deleted (GDPR, default 90)
# RETENTION_DAYS=90

# Optional: breach source, "local" (test dataset, default) or "hibp" (#13)
# BREACH_SOURCE=local
# Optional: JSON dataset for the local breach source (default: the bundled test data)
# BREACH_DATASET=
