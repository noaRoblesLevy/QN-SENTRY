POSTGRES_DB=qnsentry
POSTGRES_USER=qnsentry
POSTGRES_PASSWORD=change-me

# Optional: minutes before a queued or running scan counts as stuck (default 120)
# SCAN_TIMEOUT_MINUTES=120

# Optional: days after which scan results are deleted (GDPR, default 90).
# At least 1; the API and worker refuse to start otherwise
# RETENTION_DAYS=90

# Optional: breach source, "local" (test dataset, default) or "hibp" (#13)
# BREACH_SOURCE=local
# Optional: JSON dataset for the local breach source (default: the bundled test data)
# BREACH_DATASET=
# Needed for BREACH_SOURCE=hibp: your Have I Been Pwned API key (never commit it)
# HIBP_API_KEY=
# Optional: seconds between HIBP requests (default 6, fits 10 requests per minute).
# The pause is per scan and the worker runs 2 scans at once: use 12 to be safe with 10 per minute
# HIBP_MIN_INTERVAL_SECONDS=6
