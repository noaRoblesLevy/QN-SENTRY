FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# The OSINT tools (subfinder, nmap, exiftool, ...) are added here by the module issues

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY qnsentry ./qnsentry

RUN useradd --create-home appuser
USER appuser

CMD ["celery", "-A", "qnsentry.worker.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
